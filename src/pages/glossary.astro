---
// The glossary: each term a card with an id to link to and, where one helps, a small picture
// drawn by the calculator's own code. The whole set is given to search engines as a
// DefinedTermSet. The terms live in src/content/glossary.ts.
import { definedTermSet } from '@eurth/style/build';
import Page from '@eurth/style/components/Page.astro';
import PageHead from '@eurth/style/components/PageHead.astro';
import { site } from '../../eurth.config.mjs';
import mark from '../assets/mark.svg?raw';
import { EXAMPLES } from '../content/examples';
import { GLOSSARY, inSentence } from '../content/glossary';
import { illustrate, type Illustration } from '../content/pictures';
import { worked } from '../content/worked';
import { listWords } from '../seats/format';
import { defaultElection } from '../seats/model';

const name = 'Glossary of election and parliament terms';
const byId = new Map(GLOSSARY.map((t) => [t.id, t]));
// "See also a, b and c." as one line of markup, so no space creeps in before a comma. The
// terms are the glossary's own words, never a visitor's.
const seeAlso = (ids: string[]): string => `See also ${listWords(ids.map((id) => `<a href="#${id}">${inSentence(byId.get(id)!.term)}</a>`))}.`;

// A picture for the terms that are easier shown than said. Each opens in the calculator.
const example = (id: string) => EXAMPLES.find((x) => x.id === id)!.election;
const teland = defaultElection();
const art: Record<string, Illustration> = {
  bonus: illustrate(example('calvessa')),
  coalition: illustrate(teland, { coalition: [1, 2], layout: 'westminster' }),
  'first-past-the-post': illustrate(example('brackland')),
  hemicycle: illustrate(teland, { layout: 'hemicycle' }),
  horseshoe: illustrate(example('nine-rivers'), { layout: 'horseshoe' }),
  'hung-parliament': illustrate(teland),
  overhang: illustrate(worked('overhang').election),
  threshold: illustrate(worked('threshold').election),
  'westminster-layout': illustrate(example('brackland'), { layout: 'westminster' }),
};
---

<Page
  site={site}
  title={name}
  description="Every term Seats uses, in a sentence or two each: D'Hondt, Sainte-Laguë, quota, threshold, overhang seat, hung parliament, coalition and more."
  crumbs={[{ name: 'Glossary', path: '/glossary/' }]}
  jsonld={[definedTermSet(site, { name, path: '/glossary/', terms: GLOSSARY })]}
>
  <!-- Seats' own mark, in front of its name: a red leather armchair with the yurt on its back. -->
  <Fragment slot="mark" set:html={mark} />
  <PageHead site={site} kicker="Glossary" title={name}>
    <Fragment slot="lead">
      The words of electoral arithmetic, in a sentence or two each. The <a href="/guide/">guide</a> shows how they fit together, with worked examples; the
      <a href="/">calculator</a> does the sums.
    </Fragment>
  </PageHead>
  <dl class="eu-terms">
    {
      GLOSSARY.map((t) => (
        <div class="eu-term" id={t.id}>
          <dt>{t.term}</dt>
          <dd>
            {art[t.id] && (
              <div class="eu-term-art">
                <a href={art[t.id]!.href}>
                  <img src={art[t.id]!.src} alt={art[t.id]!.alt} width="1200" height="630" loading="lazy" />
                </a>
              </div>
            )}
            <span>{t.definition}</span>
            {t.see && t.see.length > 0 && <span class="eu-muted" set:html={seeAlso(t.see)} />}
          </dd>
        </div>
      ))
    }
  </dl>
</Page>
