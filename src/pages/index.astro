---
// The calculator, and under it what search engines and newcomers both want: what it is, how to
// use it, and answers to the usual questions (also given to search engines as structured data).
import { faqPage, webApplication } from '@eurth/style/build';
import { faChartPie } from '@fortawesome/free-solid-svg-icons';
import Page from '@eurth/style/components/Page.astro';
import ThanksItem from '@eurth/style/components/ThanksItem.astro';
import { site } from '../../eurth.config.mjs';
import mark from '../assets/mark.svg?raw';
import Calculator from '../ui/Calculator.svelte';

const faq = [
  {
    q: 'Is Seats free?',
    a: 'Yes. There is no account, no watermark and no paid tier. It is made by the Eurth worldbuilding community for anyone who needs it.',
  },
  {
    q: 'Which electoral systems can it calculate?',
    a: "D'Hondt, Sainte-Laguë, modified Sainte-Laguë, and largest remainder with the Hare or the Droop quota, each with an optional threshold and majority bonus. It also handles mixed-member systems, where you enter the district seats and it works out the list seats. For first past the post or anything else, enter the seats each party won and it draws the chamber.",
  },
  {
    q: 'Where is my election saved?',
    a: 'In its link. The link holds every party, vote and setting, so copying the link is saving it. You can also download the chart, export the table as Markdown or wikitext, or save your nation as a profile file that the other Eurth tools can read. Nothing is kept in your browser or on a server.',
  },
  {
    q: 'Can I use the parliament chart on a wiki or in a forum post?',
    a: 'Yes. Download it as SVG, PNG or WebP in six sizes, and export the results as Markdown for the forum or as a wikitext table for a wiki. The pictures are yours to use anywhere.',
  },
  {
    q: 'How does it break a tie?',
    a: 'A dead heat for a seat goes to the party with more votes, then to the party listed first, and Seats tells you when that happened. Real election laws mostly draw lots, so feel free to overrule it.',
  },
  {
    q: 'Does it work offline, and on a phone?',
    a: 'Yes to both. After the first visit the site keeps a copy of itself on your device and opens without a connection.',
  },
];
---

<Page
  site={site}
  jsonld={[
    webApplication(site, {
      featureList: [
        "D'Hondt, Sainte-Laguë and largest remainder seat calculator",
        'Mixed-member systems with overhang seats',
        'Thresholds and majority bonus',
        'Parliament chart: hemicycle, horseshoe and Westminster layouts',
        'Coalition builder',
        'SVG, PNG and WebP downloads', 'Markdown, wikitext, CSV and JSON export',
        'Link that holds the whole election',
        'Nation profile file',
      ],
    }),
    faqPage(faq),
  ]}
>
  <!-- Seats' own mark, in front of its name: a red leather armchair with the yurt on its back. -->
  <Fragment slot="mark" set:html={mark} />
  <div class="eu-stack">
    <header class="eu-stack intro">
      <p class="eu-kicker">Seats, by Eurth</p>
      <h1>Turn votes into seats</h1>
      <p class="eu-lead">Enter your parties and their votes, pick an electoral system, and see who sits where, who can govern, and with whom. Free, in your browser, no account needed.</p>
    </header>

    <!-- client:load draws the calculator as real HTML first, then wakes it up. -->
    <Calculator client:load siteName={site.name} siteUrl={site.url} />

    <section class="eu-prose">
      <h2>How it works</h2>
      <ol>
        <li>Name the chamber and say how many seats it has, or start from a real one.</li>
        <li>List the parties in the order they sit, from left to right, with their votes as percentages or counts. You can paste them straight from a spreadsheet.</li>
        <li>Choose how votes become seats. The table shows each party's seats and how far its share of seats strays from its share of votes.</li>
        <li>Pick parties in the coalition builder to see whether they have a majority, and by how many seats.</li>
        <li>Copy the link, download the chart, or export the table as Markdown for the forum or wikitext for your nation's article.</li>
      </ol>
      <p>
        New to electoral systems? The <a href="/guide/">guide</a> works through every formula on one small election, the <a href="/glossary/">glossary</a>
        has the words, and the <a href="/examples/">examples</a> give you four made-up elections to start from.
      </p>

      <h2>Questions</h2>
      <dl>
        {
          faq.map((item) => (
            <>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>

  <!-- Seats' own line of the footer's "With thanks": whose work it stands on. -->
  <ThanksItem slot="thanks" icon={faChartPie}>
    Seats takes after the parliament diagrams of Wikipedia and the election-night seat calculators of public broadcasters. Its armchair tips its hat to the one
    Readability used to sit in.
  </ThanksItem>
</Page>

<style>
  .intro {
    gap: var(--space-2);
  }
</style>
